POSTGRES_PASSWORD=computer
# Generate: openssl rand -hex 32. Keep stable for stored IMAP passwords.
AUTH_SECRET=replace-with-a-random-secret
NEXTAUTH_URL=http://localhost:3000
COOKIE_SECURE=0
ADMIN_EMAILS=
# Set only to reuse an existing Docker volume. Leave blank on a new install.
POSTGRES_VOLUME=computer_pgdata
POSTGRES_VOLUME_EXTERNAL=false
# Client-owned Authelia integration remains stubbed until connected.
OIDC_ISSUER=REPLACE_ME
OIDC_CLIENT_ID=REPLACE_ME
OIDC_CLIENT_SECRET=REPLACE_ME

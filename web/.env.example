# Copy to .env and fill in real values.

# PostgreSQL connection string (the existing database is still named "linkos")
DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/linkos?connect_timeout=15"

# Auth.js secret, also used to encrypt stored IMAP passwords.
# Generate one with: openssl rand -base64 32
# Keep it stable: changing it makes saved IMAP passwords unreadable.
NEXTAUTH_SECRET="<RANDOM_SECRET>"
AUTH_SECRET="<SAME_RANDOM_SECRET>"

# Public URL the app is served on (used for auth callbacks)
NEXTAUTH_URL="https://computer.yourdomain.com"

# Authelia OIDC: stubbed until real values are set (see docs/AUTHELIA.md)
OIDC_ISSUER=REPLACE_ME
OIDC_CLIENT_ID=REPLACE_ME
OIDC_CLIENT_SECRET=REPLACE_ME

# Optional: comma-separated emails that are always admins
ADMIN_EMAILS=

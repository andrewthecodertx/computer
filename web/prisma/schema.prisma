generator client {
    provider = "prisma-client-js"
    // Host (debian) and Alpine runtime both, so the client works in dev and in
    // the Docker image (node:22-alpine = linux-musl-openssl-3.0.x).
    binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum KanbanStatus {
  INBOX
  TODO
  IN_PROGRESS
  DONE
  ARCHIVED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("USER") // USER | ADMIN
  pages         Page[]
  kanbanColumns KanbanColumn[]
  signalSources SignalSource[]
  signals       Signal[]
  accounts      Account[]
  sessions      Session[]
  bookmarks     Bookmark[]
  tags          Tag[]
  contacts      Contact[]
  imapConfig    ImapConfig?
  sharedBookmarks BookmarkShare[]
  sharedTags      TagShare[]
  sharedDates     SharedDate[]   @relation("SharedDateRecipient")
  createdSharedDates SharedDate[] @relation("SharedDateCreator")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Bookmark {
  id              String       @id @default(cuid())
  url             String
  title           String?
  description     String?
  favicon         String?
  ogImage         String?
  ogTitle         String?
  ogDescription   String?
  notes           String?      @db.Text
  dueDate         DateTime?
  alertAt         DateTime?
  alertSent       Boolean      @default(false)
  kanbanStatus    KanbanStatus @default(INBOX)
  kanbanColumnId  String?
  kanbanColumn    KanbanColumn? @relation(fields: [kanbanColumnId], references: [id], onDelete: SetNull)
  pageLinks       PageBookmark[]
  signalSources   SignalSource[]
  signals         Signal[]
  imapWatchEnabled Boolean     @default(false)
  imapQuery       String?
  isPublic        Boolean      @default(false)
  ownerId         String
  owner           User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  contactId       String?
  contact         Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  tags            BookmarkTag[]
  sharedWith      BookmarkShare[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([ownerId])
  @@index([contactId])
  @@index([kanbanStatus])
  @@index([kanbanColumnId])
  @@index([dueDate])
  @@index([alertAt])
}

model Tag {
  id        String       @id @default(cuid())
  name      String
  color     String       @default("#6366f1")
  ownerId   String
  owner     User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  bookmarks BookmarkTag[]
  sharedWith TagShare[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([name, ownerId])
  @@index([ownerId])
}

model BookmarkTag {
  bookmarkId String
  tagId      String
  bookmark   Bookmark @relation(fields: [bookmarkId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([bookmarkId, tagId])
  @@index([tagId])
}

model BookmarkShare {
  bookmarkId String
  userId     String
  bookmark   Bookmark @relation(fields: [bookmarkId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([bookmarkId, userId])
  @@index([userId])
}

model TagShare {
  tagId     String
  userId    String
  tag       Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([tagId, userId])
  @@index([userId])
}

model Contact {
  id          String     @id @default(cuid())
  uid         String
  displayName String
  email       String?
  phone       String?
  cardDavUrl  String?
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookmarks   Bookmark[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([uid, userId])
  @@index([userId])
}

model ImapConfig {
  id       String  @id @default(cuid())
  host     String
  port     Int     @default(993)
  tls      Boolean @default(true)
  username String
  password String
  folder   String  @default("INBOX")
  userId   String  @unique
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Editable per-user kanban columns. `key` maps legacy KanbanStatus values for the default set.
model KanbanColumn {
  id        String     @id @default(cuid())
  label     String
  color     String     @default("#64748b")
  position  Int        @default(0)
  key       String?
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookmarks Bookmark[]
  createdAt DateTime   @default(now())

  @@index([userId, position])
}

// A page: Markdown meta-collection of URLs and notes, browsed as a workspace tab.
model Page {
  id        String         @id @default(cuid())
  title     String
  content   String         @default("") @db.Text
  icon      String?
  pinned    Boolean        @default(false)
  position  Int            @default(0)
  ownerId   String
  owner     User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  bookmarks PageBookmark[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([ownerId, position])
}

model PageBookmark {
  pageId     String
  bookmarkId String
  position   Int      @default(0)
  page       Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  bookmark   Bookmark @relation(fields: [bookmarkId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([pageId, bookmarkId])
  @@index([bookmarkId])
}

// A watcher attached to a URL (email first; more types later). `config` is type-specific JSON.
model SignalSource {
  id            String    @id @default(cuid())
  type          String
  config        Json      @default("{}")
  enabled       Boolean   @default(true)
  lastCheckedAt DateTime?
  lastStatus    String?
  bookmarkId    String
  bookmark      Bookmark  @relation(fields: [bookmarkId], references: [id], onDelete: Cascade)
  ownerId       String
  owner         User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  signals       Signal[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([bookmarkId])
  @@index([ownerId])
}

// One event from the outside world related to a URL.
model Signal {
  id         String        @id @default(cuid())
  sourceType String
  title      String
  summary    String?       @db.Text
  url        String?
  externalId String?
  occurredAt DateTime      @default(now())
  read       Boolean       @default(false)
  sourceId   String?
  source     SignalSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  bookmarkId String
  bookmark   Bookmark      @relation(fields: [bookmarkId], references: [id], onDelete: Cascade)
  ownerId    String
  owner      User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now())

  @@unique([sourceId, externalId])
  @@index([bookmarkId, occurredAt])
  @@index([ownerId, occurredAt])
}

model SharedDate {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  note      String?
  creatorId String
  creator   User     @relation("SharedDateCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  recipientId String
  recipient User     @relation("SharedDateRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([recipientId])
  @@index([creatorId])
  @@index([date])
}
